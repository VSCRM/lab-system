# Copy this file to .env.local and fill in values as needed.
# Nothing here is required — the app works fully without any of it.

# Sentry DSN for production error monitoring. Leave unset to disable
# monitoring entirely (safe no-op — see src/lib/monitoring.ts).
# VITE_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
